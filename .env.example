# Copy to .env and fill in. .env is gitignored; this file is not.
# Full walkthrough of where each value comes from: docs/SELF-HOSTING.md

# --- Secrets: mark these Sensitive in Netlify ------------------------------
# Both can spend money or read every row in the database. Everything else here
# is public by design.

# platform.openai.com. Set a monthly usage limit in OpenAI's own dashboard as
# well; the app's session caps are code, and code can have bugs.
OPENAI_API_KEY=

# Supabase project settings, API section. Bypasses row-level security, so it is
# only ever read by serverless functions and never reaches a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public values: these appear in the browser on every page load ---------
# Marking these sensitive protects nothing and only makes them awkward to
# inspect. What keeps players out of each other's rows is row-level security.

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_SITE_URL=http://localhost:5173

# --- Google sign-in --------------------------------------------------------
# These are read by `supabase config push` when it applies supabase/config.toml.
# They belong to your Supabase project's auth settings, not to Netlify.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
